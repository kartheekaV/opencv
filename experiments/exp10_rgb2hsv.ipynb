    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "img = cv2.imread(\"shinchan.jpg\")\n",
    "\n",
    "hsv_img = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)\n",
    "\n",
    "plt.imshow(hsv_img)\n",
    "plt.axis('off')\n",
    "plt.show()"
