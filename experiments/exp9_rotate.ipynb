   "source": [
    "import cv2\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "img = cv2.imread(\"shinchan.jpg\")\n",
    "\n",
    "rotated_img = cv2.rotate(img, cv2.ROTATE_90_CLOCKWISE)\n",
    "\n",
    "rotated_img_rgb = cv2.cvtColor(rotated_img, cv2.COLOR_BGR2RGB)\n",
    "\n",
    "plt.imshow(rotated_img_rgb)\n",
    "plt.axis('off')\n",
    "plt.show()"
   ]
  },
